# Frontend build-time configuration (Vite). These values are PUBLIC: they are
# embedded in the JavaScript bundle. Never put a service-role key or any other
# secret in a VITE_ variable.
#
# Copy to .env.local for local development. For GitHub Pages these are set as
# repository variables (see docs/SETUP.md).

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to expose: RLS protects the data.
VITE_SUPABASE_ANON_KEY=

# Base path the app is served from. "/" locally; "/<repo-name>/" on GitHub Pages.
VITE_BASE_PATH=/
